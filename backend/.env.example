# Copiez ce fichier en ".env" puis renseignez vos valeurs locales.
DJANGO_SECRET_KEY=changez-moi-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://localhost:5173

# Base de données locale : postgres (par défaut) ou sqlite (tests rapides sans PostgreSQL)
DB_ENGINE=postgres
DB_NAME=hotel_reservation_db
DB_USER=hotel_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Mise en ligne seulement (laisser en commentaire en local) ---
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base
# CLOUDINARY_URL=cloudinary://CLE_API:SECRET_API@NOM_DU_CLOUD
